{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh",
            "args": []
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/_python.sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/model_guard.py"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/_python.sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/token_monitor.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
